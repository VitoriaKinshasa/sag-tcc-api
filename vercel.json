{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/preparar-vercel.mjs",
  "rewrites": [
    { "source": "/teste", "destination": "/teste/index.html" },
    { "source": "/((?!api/|assets/|teste/)[^.]*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/prazos", "schedule": "0 11 * * *" }
  ]
}